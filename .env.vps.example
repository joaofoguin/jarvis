# Copie para .env.vps. Nunca versione o arquivo real.
APP_ENV=production
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Reutilize a URL PostgreSQL/Neon do projeto ou informe seu PostgreSQL na VPS.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_API_TOKEN=

# Domínio(s) do frontend separados por vírgula. Não use * em produção.
CORS_ORIGINS=https://app.seudominio.com

# Em produção, aplique sql/vps_core.sql e mantenha false.
AUTO_CREATE_SCHEMA=false
DEEPSEEK_TIMEOUT_SECONDS=45
MAX_TOOL_ROUNDS=4
CONVERSATION_HISTORY_LIMIT=16
JARVIS_DOMAIN=api.seudominio.com
