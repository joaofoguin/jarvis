# Copie para .env.vps. Nunca versione o arquivo real.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# A mesma URL do Neon usada na Vercel e no agente.
POSTGRES_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Gere cada um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AGENT_TOKEN: o mesmo do .env do notebook. JARVIS_API_TOKEN: o que você digita na página /app.
AGENT_TOKEN=
JARVIS_API_TOKEN=

# Domínio que aponta para a VPS (usado pelo Caddy para o HTTPS).
JARVIS_DOMAIN=jarvis.seudominio.com

# Fuso usado para contar o uso de IA de "hoje" no painel /app (padrão: America/Sao_Paulo).
# JARVIS_TIMEZONE=America/Sao_Paulo
