FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-vps.txt .
RUN pip install --no-cache-dir -r requirements-vps.txt
COPY server ./server
COPY vps_main.py .
RUN useradd --create-home --uid 10001 jarvis
USER jarvis
EXPOSE 8000
CMD ["uvicorn", "vps_main:app", "--host", "0.0.0.0", "--port", "8000"]
